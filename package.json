{
    "name": "@fr0st/color",
    "version": "5.0.2",
    "private": false,
    "description": "A modern JavaScript library for parsing, converting, and formatting colors.",
    "keywords": [
        "color",
        "rgb",
        "hex",
        "hsl",
        "hwb",
        "lab",
        "lch",
        "oklab",
        "oklch",
        "display-p3",
        "color-conversion",
        "color-space",
        "css-color"
    ],
    "homepage": "https://github.com/elusivecodes/FrostColor",
    "bugs": {
        "url": "https://github.com/elusivecodes/FrostColor/issues",
        "email": "elusivecodes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elusivecodes/FrostColor.git"
    },
    "license": "MIT",
    "author": "Elusive <elusivecodes@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./src/index.js"
    },
    "main": "src/index.js",
    "jsdelivr": "dist/frost-color.min.js",
    "unpkg": "dist/frost-color.min.js",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "npm run bundle && npm run minify",
        "bundle": "rollup --config",
        "lint": "eslint",
        "minify": "terser --compress passes=2 --mangle --source-map \"content=dist/frost-color.js.map,url=frost-color.min.js.map\" --output dist/frost-color.min.js dist/frost-color.js",
        "test": "mocha --forbid-only \"test/unit/**/*.test.js\""
    },
    "devDependencies": {
        "@fr0st/eslint-config": "^5.0.0",
        "eslint": "^10.8.1",
        "mocha": "^11.8.0",
        "rollup": "^4.62.4",
        "terser": "^5.50.0"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
