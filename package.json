{
    "name": "@fr0st/color",
    "version": "5.2.0",
    "private": false,
    "description": "A modern JavaScript library for parsing, converting, and formatting colors.",
    "keywords": [
        "color",
        "rgb",
        "hex",
        "hsl",
        "hwb",
        "lab",
        "lch",
        "oklab",
        "oklch",
        "display-p3",
        "color-conversion",
        "color-space",
        "css-color"
    ],
    "homepage": "https://github.com/elusivecodes/FrostColor",
    "bugs": {
        "url": "https://github.com/elusivecodes/FrostColor/issues",
        "email": "elusivecodes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elusivecodes/FrostColor.git"
    },
    "license": "MIT",
    "author": "Elusive <elusivecodes@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/frost-color.esm.js",
            "default": "./dist/frost-color.esm.js"
        },
        "./dist/*": "./dist/*",
        "./src/*": "./src/*"
    },
    "main": "./dist/frost-color.esm.js",
    "jsdelivr": "./dist/frost-color.min.js",
    "unpkg": "./dist/frost-color.min.js",
    "module": "./dist/frost-color.esm.js",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "vite build && vite build --mode umd",
        "lint": "eslint",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@fr0st/eslint-config": "^5.0.1",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.9.1",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
